{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "arriva/wave-divider",
	"title": "Wave Divider",
	"category": "design",
	"icon": "marker",
	"description": "A wave-shaped section divider between content sections. Pull up over the previous section so a transparent top reveals it instead of the page background.",
	"keywords": [ "wave", "divider", "separator", "section" ],
	"textdomain": "arriva",
	"attributes": {
		"shape": { "type": "string", "default": "" },
		"offset": { "type": "number", "default": 0 },
		"topColor": { "type": "string", "default": "" },
		"bottomColor": { "type": "string", "default": "" },
		"overlapPrevious": { "type": "boolean", "default": false }
	},
	"supports": { "html": false, "align": [ "full", "wide" ] },
	"editorScript": "file:./index.js",
	"style": "file:./style.css"
}
