{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "arriva/page-header",
	"title": "Page Header",
	"category": "design",
	"icon": "heading",
	"description": "Compact page title band for subpages (not the home hero).",
	"keywords": [ "header", "title", "page" ],
	"textdomain": "arriva",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"subtitle": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "full", "wide" ]
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
