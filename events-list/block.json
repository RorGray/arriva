{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "arriva/events-list",
	"title": "Events List",
	"category": "widgets",
	"icon": "list-view",
	"description": "Full Termine list for a calendar year, grouped by month.",
	"keywords": [ "termine", "events", "calendar" ],
	"textdomain": "arriva",
	"attributes": {
		"year": {
			"type": "number",
			"default": 0
		},
		"showYear": {
			"type": "boolean",
			"default": true
		},
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"subtitle": {
			"type": "string",
			"default": ""
		},
		"emptyText": {
			"type": "string",
			"default": ""
		},
		"note": {
			"type": "string",
			"default": ""
		},
		"showCalendar": {
			"type": "boolean",
			"default": true
		},
		"listLabel": {
			"type": "string",
			"default": ""
		},
		"calendarLabel": {
			"type": "string",
			"default": ""
		},
		"icalLabel": {
			"type": "string",
			"default": ""
		},
		"pastLabel": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "full", "wide" ],
		"color": {
			"background": true,
			"text": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "arriva-events",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
