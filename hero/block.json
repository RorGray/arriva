{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "arriva/hero",
	"title": "Hero Section",
	"category": "design",
	"icon": "cover-image",
	"description": "Full-width hero with editable text, colours, and imagery. Supports fixed scroll-over behaviour — pair with a Wave Divider using overlap after the hero.",
	"keywords": [ "hero", "banner", "header", "cover" ],
	"textdomain": "arriva",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"subtitle": {
			"type": "string",
			"default": ""
		},
		"primaryBtnText": {
			"type": "string",
			"default": ""
		},
		"primaryBtnUrl": {
			"type": "string",
			"default": ""
		},
		"secondaryBtnText": {
			"type": "string",
			"default": ""
		},
		"secondaryBtnUrl": {
			"type": "string",
			"default": ""
		},
		"backgroundColor": {
			"type": "string",
			"default": "#18222a"
		},
		"accentColor": {
			"type": "string",
			"default": "#1a93a4"
		},
		"accentDarkColor": {
			"type": "string",
			"default": "#117585"
		},
		"glowColor": {
			"type": "string",
			"default": "#1a93a4"
		},
		"iconUrl": {
			"type": "string",
			"default": ""
		},
		"iconAlt": {
			"type": "string",
			"default": ""
		},
		"backgroundImageUrl": {
			"type": "string",
			"default": ""
		},
		"minHeight": {
			"type": "number",
			"default": 600
		},
		"fixedScroll": {
			"type": "boolean",
			"default": true
		},
		"showIcon": {
			"type": "boolean",
			"default": true
		},
		"showGlow": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "full", "wide" ]
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"viewScript": "file:./view.js"
}
