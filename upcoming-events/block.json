{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "arriva/upcoming-events",
	"title": "Upcoming Events",
	"category": "widgets",
	"icon": "calendar",
	"description": "Lists upcoming Termine (arriva_event) sorted by date.",
	"keywords": [ "termine", "events", "calendar", "mitglieder" ],
	"textdomain": "arriva",
	"attributes": {
		"count": {
			"type": "number",
			"default": 8
		},
		"eyebrow": {
			"type": "string",
			"default": "Termine"
		},
		"heading": {
			"type": "string",
			"default": "Kommende Veranstaltungen"
		},
		"subtitle": {
			"type": "string",
			"default": "Alle öffentlichen Vereinstermine. Interne Infos findest du im Mitgliederbereich."
		},
		"moreLabel": {
			"type": "string",
			"default": "Alle Termine im Mitgliederbereich"
		},
		"moreUrl": {
			"type": "string",
			"default": ""
		},
		"backgroundColor": {
			"type": "string",
			"default": "contrast"
		},
		"textColor": {
			"type": "string",
			"default": "base"
		}
	},
	"supports": {
		"html": false,
		"align": [ "full", "wide" ],
		"color": {
			"background": true,
			"text": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
